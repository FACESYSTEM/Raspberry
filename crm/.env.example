# 画面に出す名前。**コードに社名を埋めない**
ORG_NAME=〈社名〉

# **既定値のままでは起動しません。**
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 保管したパスワードの暗号化鍵。**失うと復号できません。**
# 環境ごとに別の鍵を作り、控えを持たせてください
CREDENTIAL_KEY=

# 招待リンク・再設定リンクに使う土台のURL
BASE_URL=http://127.0.0.1:8010

# メール送信。**空なら送りません**（画面にもその旨が出ます）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# 招待リンクの有効時間
INVITE_TTL_HOURS=72
